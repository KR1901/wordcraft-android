<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Light counterpart; the dark variant lives in values-night so the system bars
         match the Compose colour scheme instead of staying light in dark mode. -->
    <style name="Theme.WordCraft" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@android:color/white</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
    </style>
</resources>
